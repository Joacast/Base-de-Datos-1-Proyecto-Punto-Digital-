-- Procedimientos
-- Ejecutar primero sql/tecnico/transacciones/transacciones.
USE punto_digital;
GO

-- Procedimiento almacenado para registrar una venta en el sistema
CREATE OR ALTER PROCEDURE sp_registrar_venta
    @p_cliente_id INT,
    @p_producto_id INT,
    @p_cantidad INT,
    @p_metodo_pago VARCHAR(30) = 'Efectivo'
AS
BEGIN
    SET NOCOUNT ON;

    -- Reutilizar la transacción para registrar la venta y descontar stock juntos.
    EXEC dbo.sp_registrar_venta_transaccional
        @p_cliente_id = @p_cliente_id,
        @p_producto_id = @p_producto_id,
        @p_cantidad = @p_cantidad,
        @p_metodo_pago = @p_metodo_pago;
END;
GO

-- Demostracion:
USE punto_digital;
GO

-- Demostración 1: Ejecución del procedimiento con datos válidos
EXEC sp_registrar_venta 
    @p_cliente_id = 1, 
    @p_producto_id = 2, 
    @p_cantidad = 3, 
    @p_metodo_pago = 'Transferencia';

-- Comprobación: consultar el último registro ingresado
SELECT TOP 1 * 
FROM registro_venta 
ORDER BY registro_venta_id DESC;
GO

-- Demostración 2: Ejecución enviando una cantidad inválida (control de flujo)
EXEC sp_registrar_venta 
    @p_cliente_id = 1, 
    @p_producto_id = 2, 
    @p_cantidad = 0, 
    @p_metodo_pago = 'Efectivo';
GO

