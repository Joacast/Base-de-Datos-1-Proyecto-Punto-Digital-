USE punto_digital;
GO

-- ============================================================================
-- ETAPA V - ITEM 4: ÍNDICES (CREACIÓN DE LA ESTRUCTURA DE OPTIMIZACIÓN)
-- ============================================================================

-- 1. ÍNDICE PARA PERSONAS (Optimiza el filtrado por provincia)
-- Creación de un índice no agrupado sobre la columna 'provincia' de la tabla 'persona'.
-- Se utiliza la cláusula INCLUDE para agregar columnas consultadas frecuentemente (Covering Index),
-- El DNI se obtiene de cliente mediante JOIN; el contacto está en persona.
IF EXISTS (SELECT * FROM sys.indexes WHERE name = 'IX_persona_provincia' AND object_id = OBJECT_ID('persona'))
    DROP INDEX IX_persona_provincia ON persona;
GO

CREATE NONCLUSTERED INDEX IX_persona_provincia
ON persona (provincia)
INCLUDE (numero_telefono);
GO


-- 2. ÍNDICE PARA VENTAS (Optimiza la búsqueda y rangos por fecha)
-- Creación de un índice no agrupado sobre la columna 'fecha_compra' de la tabla 'registro_venta'.
-- Permite agilizar reportes mensuales y análisis por períodos sin recorrer toda la tabla.
IF EXISTS (SELECT * FROM sys.indexes WHERE name = 'IX_registro_venta_fecha_compra' AND object_id = OBJECT_ID('registro_venta'))
    DROP INDEX IX_registro_venta_fecha_compra ON registro_venta;
GO

CREATE NONCLUSTERED INDEX IX_registro_venta_fecha_compra
ON registro_venta (fecha_compra)
INCLUDE (cliente_id, producto_id, cantidad, monto_total);
GO
