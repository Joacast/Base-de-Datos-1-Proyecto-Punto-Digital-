CREATE OR ALTER PROCEDURE sp_registrar_venta_transaccional
    @p_cliente_id INT,
    @p_producto_id INT,
    @p_cantidad INT,
    @p_metodo_pago VARCHAR(30) = 'Efectivo'
AS
BEGIN
    SET NOCOUNT ON;

    -- Validar cantidad mínima
    IF @p_cantidad <= 0
    BEGIN
        PRINT 'Error: La cantidad de productos debe ser mayor a 0.';
        RETURN;
    END

    -- Validar existencia del cliente
    IF NOT EXISTS (SELECT 1 FROM cliente WHERE cliente_id = @p_cliente_id)
    BEGIN
        PRINT 'Error: El cliente especificado no existe.';
        RETURN;
    END

    -- Validar existencia del producto
    IF NOT EXISTS (SELECT 1 FROM producto WHERE producto_id = @p_producto_id)
    BEGIN
        PRINT 'Error: El producto especificado no existe.';
        RETURN;
    END

    -- Declarar variables para cálculos
    DECLARE @v_precio_unitario DECIMAL(10,2);
    DECLARE @v_monto_total DECIMAL(10,2);
    DECLARE @v_stock_actual INT;

    SELECT 
        @v_precio_unitario = precio_venta,
        @v_stock_actual = stock
    FROM producto 
    WHERE producto_id = @p_producto_id;

    -- Iniciar la transacción
    BEGIN TRANSACTION;

    -- 1. Actualizar el inventario restando la cantidad vendida
    UPDATE producto
    SET stock = stock - @p_cantidad
    WHERE producto_id = @p_producto_id;

    -- 2. Validación de regla de negocio: Control de stock no negativo
    IF (SELECT stock FROM producto WHERE producto_id = @p_producto_id) < 0
    BEGIN
        ROLLBACK TRANSACTION;
        PRINT 'Error: Stock insuficiente. La venta fue cancelada.';
        RETURN;
    END

    -- 3. Calcular monto total
    SET @v_monto_total = @v_precio_unitario * @p_cantidad;

    -- 4. Registrar la venta en la tabla real
    INSERT INTO registro_venta (
        cliente_id, 
        producto_id, 
        fecha_compra, 
        cantidad, 
        precio_unitario, 
        monto_total, 
        metodo_pago
    )
    VALUES (
        @p_cliente_id, 
        @p_producto_id, 
        GETDATE(), 
        @p_cantidad, 
        @v_precio_unitario, 
        @v_monto_total, 
        @p_metodo_pago
    );

    -- Confirmar los cambios si todo salió bien
    COMMIT TRANSACTION;
    PRINT 'Venta registrada e inventario actualizado con éxito.';
END;
